# Cấu hình Firebase cho multiplayer giữa các thiết bị.
# Cần bật Authentication (Email/Password), tạo Cloud Firestore và triển khai firestore.rules.
# Chỉ tạo Realtime Database chưa đủ: multiplayer hiện dùng Cloud Firestore.
# Điền các biến này tại bước BUILD trên Cloudflare rồi build/deploy lại.
# Để trống => Local Fallback, chỉ đồng bộ tab cùng trình duyệt; không kết nối thiết bị khác.
# Chỉ dùng cấu hình Firebase Web công khai, không điền service-account key hoặc mật khẩu.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
